<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range .Sitemap}}
  <url>
    <loc>{{xml .AbsURL}}</loc>
    <lastmod>{{.Entry.UpdatedAt.UTC.Format "2006-01-02"}}</lastmod>
{{- with .Data.seo}}{{with .sitemapPriority}}
    <priority>{{xml .}}</priority>
{{- end}}{{end}}
  </url>
{{- end}}
</urlset>